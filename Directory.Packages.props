<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows App SDK current stable (see docs/DECISIONS.md ADR-002). -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.5.1" />

    <!-- App composition -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <!-- PDF (wired in later milestones; versions pinned now for ADR stability) -->
    <PackageVersion Include="PDFiumCore" Version="4688.0.0" />
    <PackageVersion Include="PdfPig" Version="0.1.16" />

    <!-- Imaging (wired when M5 lands) -->
    <PackageVersion Include="Magick.NET-Q16-AnyCPU" Version="14.17.2" />

    <!-- Test -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- 7.x remains Apache-2.0; 8.x introduces a commercial license key requirement. -->
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />

    <!-- Analyzers -->
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.401" />
  </ItemGroup>
</Project>
