<Window
    x:Class="Glyph.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Glyph">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <Grid Grid.Row="0" Padding="16,12,16,8" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Vertical" Spacing="2">
                <TextBlock Text="Glyph"
                           FontSize="28"
                           FontWeight="SemiBold"
                           CharacterSpacing="40" />
                <TextBlock Text="Native Windows document preview"
                           Opacity="0.7"
                           FontSize="12" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="OpenButton" Content="Open…" Click="OpenButton_Click" />
                <Button x:Name="CloseTabButton" Content="Close tab" Click="CloseTabButton_Click" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="220,*" Margin="12,0,12,12" ColumnSpacing="12">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="Sidebar" FontWeight="SemiBold" />
                    <TextBlock x:Name="SidebarStatus"
                               Text="Thumbnails and document tools will appear here."
                               TextWrapping="WrapWholeWords"
                               Opacity="0.75"
                               FontSize="12" />
                    <TextBlock Text="Recent" FontWeight="SemiBold" Margin="0,12,0,0" />
                    <ListView x:Name="RecentList"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="RecentList_ItemClick"
                              Height="220">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}"
                                           ToolTipService.ToolTip="{Binding Path}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    x:Name="DropHost"
                    AllowDrop="True"
                    DragOver="DropHost_DragOver"
                    Drop="DropHost_Drop"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="16">
                <Grid RowDefinitions="Auto,*">
                    <TabView x:Name="DocumentTabs"
                             AddTabButtonClick="DocumentTabs_AddTabButtonClick"
                             TabCloseRequested="DocumentTabs_TabCloseRequested"
                             SelectionChanged="DocumentTabs_SelectionChanged" />

                    <StackPanel Grid.Row="1"
                                x:Name="EmptyState"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="8">
                        <TextBlock Text="Open a PDF or image to begin"
                                   FontSize="20"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="File → Open, drag files here, or pick a recent document."
                                   Opacity="0.7"
                                   HorizontalAlignment="Center"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Padding="16,8" ColumnDefinitions="*,Auto">
            <TextBlock x:Name="StatusText" Text="Ready" Opacity="0.75" FontSize="12" />
            <TextBlock Grid.Column="1"
                       Text="Milestone 0 foundation"
                       Opacity="0.55"
                       FontSize="12" />
        </Grid>
    </Grid>
</Window>
