<Window
    x:Class="Glyph.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Glyph">

    <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,*,Auto" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <Grid Grid.Row="0" Padding="16,12,16,4" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Vertical" Spacing="2">
                <TextBlock Text="Glyph"
                           FontSize="28"
                           FontWeight="SemiBold"
                           CharacterSpacing="40" />
                <TextBlock Text="Native Windows document preview"
                           Opacity="0.7"
                           FontSize="12" />
            </StackPanel>
        </Grid>

        <MenuBar Grid.Row="1" Margin="8,0,8,4" TabIndex="1" XYFocusKeyboardNavigation="Enabled">
            <MenuBarItem Title="File">
                <MenuFlyoutItem x:Name="OpenMenuItem" Text="Open…" Click="OpenMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="O" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="OpenMultipleMenuItem" Text="Open Multiple…" Click="OpenMultipleMenuItem_Click" />
                <MenuFlyoutItem x:Name="NewFromClipboardMenuItem" Text="New from Clipboard" Click="NewFromClipboardMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control,Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="CaptureCameraMenuItem" Text="Capture from Camera…" Click="CaptureCameraMenuItem_Click" />
                <MenuFlyoutItem x:Name="ScanMenuItem" Text="Scan…" Click="ScanMenuItem_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="SaveMenuItem" Text="Save" Click="SaveMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="SaveAsMenuItem" Text="Save As…" Click="SaveAsMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Control,Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="DuplicateMenuItem" Text="Duplicate" Click="DuplicateMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="D" Modifiers="Control,Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="RenameMenuItem" Text="Rename…" Click="RenameMenuItem_Click" />
                <MenuFlyoutItem x:Name="MoveMenuItem" Text="Move…" Click="MoveMenuItem_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="ShareMenuItem" Text="Share…" Click="ShareMenuItem_Click" />
                <MenuFlyoutItem x:Name="ShowInExplorerMenuItem" Text="Show in File Explorer" Click="ShowInExplorerMenuItem_Click" />
                <MenuFlyoutItem x:Name="PropertiesMenuItem" Text="Properties" Click="PropertiesMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="I" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="VersionSnapshotsMenuItem" Text="Version Snapshots…" Click="VersionSnapshotsMenuItem_Click" AutomationProperties.Name="Version snapshots" />
                <MenuFlyoutItem x:Name="CopyPathMenuItem" Text="Copy File Path" Click="CopyPathMenuItem_Click" />
                <MenuFlyoutItem x:Name="CopyFileMenuItem" Text="Copy File" Click="CopyFileMenuItem_Click" />
                <MenuFlyoutItem x:Name="OpenWithMenuItem" Text="Open With Default App" Click="OpenWithMenuItem_Click" />
                <MenuFlyoutItem x:Name="EmailMenuItem" Text="Send Email…" Click="EmailMenuItem_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="NewWindowMenuItem" Text="New Window" Click="NewWindowMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="CloseTabMenuItem" Text="Close Tab" Click="CloseTabMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="W" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="CloseAllMenuItem" Text="Close All" Click="CloseAllMenuItem_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="ClearRecentMenuItem" Text="Clear Recent Files" Click="ClearRecentMenuItem_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="ExitMenuItem" Text="Exit" Click="ExitMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Q" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem Title="Edit">
                <MenuFlyoutItem x:Name="PasteMenuItem" Text="Paste" Click="PasteMenuItem_Click" AutomationProperties.Name="Paste">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="V" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="FindAllPdfsMenuItem" Text="Find in all open PDFs…" Click="FindAllPdfsMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" Modifiers="Control,Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem Title="View">
                <MenuFlyoutItem x:Name="ToggleSidebarMenuItem" Text="Hide Sidebar" Click="ToggleSidebarMenuItem_Click" />
                <MenuFlyoutItem x:Name="ToggleToolbarMenuItem" Text="Hide Toolbar" Click="ToggleToolbarMenuItem_Click" />
                <MenuFlyoutItem x:Name="FullscreenMenuItem" Text="Full Screen" Click="FullscreenMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F11" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem Text="Theme">
                    <RadioMenuFlyoutItem x:Name="ThemeSystemItem" Text="System" GroupName="Theme" Click="ThemeSystemItem_Click" />
                    <RadioMenuFlyoutItem x:Name="ThemeLightItem" Text="Light" GroupName="Theme" Click="ThemeLightItem_Click" />
                    <RadioMenuFlyoutItem x:Name="ThemeDarkItem" Text="Dark" GroupName="Theme" Click="ThemeDarkItem_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="PreferencesMenuItem" Text="Preferences…" Click="PreferencesMenuItem_Click" AutomationProperties.Name="Preferences" />
            </MenuBarItem>

            <MenuBarItem Title="Window">
                <MenuFlyoutItem x:Name="NextTabMenuItem" Text="Next Tab" Click="NextTabMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Tab" Modifiers="Control" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="PreviousTabMenuItem" Text="Previous Tab" Click="PreviousTabMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Tab" Modifiers="Control,Shift" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="MoveTabToNewWindowMenuItem" Text="Move Tab to New Window" Click="MoveTabToNewWindowMenuItem_Click" />
                <MenuFlyoutItem x:Name="MoveToNextMonitorMenuItem" Text="Move to Next Monitor" Click="MoveToNextMonitorMenuItem_Click" />
            </MenuBarItem>

            <MenuBarItem Title="Help">
                <MenuFlyoutItem x:Name="CheckForUpdatesMenuItem"
                                Text="Check for Updates…"
                                Click="CheckForUpdatesMenuItem_Click"
                                AutomationProperties.Name="Check for updates" />
                <MenuFlyoutItem x:Name="AboutMenuItem"
                                Text="About Glyph"
                                Click="AboutMenuItem_Click"
                                AutomationProperties.Name="About Glyph" />
            </MenuBarItem>
        </MenuBar>

        <Grid x:Name="ContentGrid" Grid.Row="2" ColumnDefinitions="Auto,6,*" Margin="12,0,12,12" ColumnSpacing="0">
            <Border x:Name="SidebarBorder"
                    Width="220"
                    TabIndex="2"
                    IsTabStop="True"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,6,0"
                    AutomationProperties.Name="Sidebar">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <TextBlock Text="Sidebar" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1"
                               x:Name="SidebarStatus"
                               Text="Thumbnails and document tools will appear here."
                               TextWrapping="WrapWholeWords"
                               Opacity="0.75"
                               FontSize="12"
                               Margin="0,8,0,0" />
                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <TextBlock Text="Recent" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ListView x:Name="RecentList"
                                  SelectionMode="None"
                                  IsItemClickEnabled="True"
                                  ItemClick="RecentList_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"
                                               ToolTipService.ToolTip="{Binding Path}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="SidebarSplitter"
                    Grid.Column="1"
                    Width="6"
                    Background="Transparent"
                    AutomationProperties.Name="Resize sidebar"
                    PointerPressed="SidebarSplitter_PointerPressed"
                    PointerMoved="SidebarSplitter_PointerMoved"
                    PointerReleased="SidebarSplitter_PointerReleased"
                    PointerCaptureLost="SidebarSplitter_PointerCaptureLost"
                    ToolTipService.ToolTip="Drag to resize sidebar">
                <Rectangle HorizontalAlignment="Center"
                           Width="2"
                           Margin="0,16"
                           Opacity="0.35"
                           Fill="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
            </Border>

            <Border Grid.Column="2"
                    x:Name="DropHost"
                    AllowDrop="True"
                    DragOver="DropHost_DragOver"
                    Drop="DropHost_Drop"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="16"
                    Margin="6,0,0,0">
                <Grid RowDefinitions="Auto,*">
                    <TabView x:Name="DocumentTabs"
                             TabIndex="3"
                             CanReorderTabs="True"
                             CanDragTabs="True"
                             AllowDropTabs="True"
                             AddTabButtonClick="DocumentTabs_AddTabButtonClick"
                             TabCloseRequested="DocumentTabs_TabCloseRequested"
                             TabItemsChanged="DocumentTabs_TabItemsChanged"
                             TabDroppedOutside="DocumentTabs_TabDroppedOutside"
                             SelectionChanged="DocumentTabs_SelectionChanged"
                             AutomationProperties.Name="Open documents" />

                    <StackPanel Grid.Row="1"
                                x:Name="EmptyState"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="8">
                        <TextBlock Text="Open a PDF or image to begin"
                                   FontSize="20"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="File → Open, drag files here, Win+Shift+S then Ctrl+V, or pick a recent document."
                                   Opacity="0.7"
                                   HorizontalAlignment="Center"
                                   TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Padding="16,8" ColumnDefinitions="*,Auto">
            <TextBlock x:Name="StatusText" Text="Ready" Opacity="0.75" FontSize="12" />
            <TextBlock Grid.Column="1"
                       Text="Native Windows document preview"
                       Opacity="0.55"
                       FontSize="12" />
        </Grid>
    </Grid>
</Window>
