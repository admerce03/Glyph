<Application
    x:Class="Glyph.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="GlyphCanvasBrush" Color="#FF1B2430" />
            <SolidColorBrush x:Key="GlyphAccentBrush" Color="#FF3D9CF0" />
            <SolidColorBrush x:Key="GlyphMutedBrush" Color="#99FFFFFF" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
